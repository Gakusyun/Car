# 车辆信息（编译时注入页面）
VITE_PLATE=车牌号
VITE_CAR=颜色 车型
VITE_EMAIL=you@example.com
# 通知图标（可选）：图片 URL，留空则用内置默认图
VITE_ICON=
# 备案号（可选）：留空则对应备案信息不显示，公安备案为空时备案图标也不显示
VITE_ICP=
VITE_GA=
# 通知接口地址与设备令牌：直接填明文，构建时自动 base64 编码注入，运行时解码
VITE_PUSH_URL=https://your-endpoint/push
VITE_DEVICE_KEY=your_device_key
# 加密推送（可选，不填则明文推送；需与手机端加密设置一致）
# VITE_ALGO: AES128 | AES192 | AES256（对应密钥 16/24/32 位）
# VITE_MODE: CBC | ECB | GCM      VITE_PAD: pkcs7 | noPadding
# VITE_KEY 为密钥明文（16/24/32 位），构建时自动 base64 编码
# VITE_IV 留空则每次随机生成（CBC 16 位 / GCM 12 位 / ECB 不需要）
VITE_ALGO=AES256
VITE_MODE=CBC
VITE_PAD=pkcs7
VITE_KEY=
VITE_IV=
